class Solution:
    def maximumAmount(self, coins):
        m, n = len(coins), len(coins[0])
        dp = [[[-10**15]*3 for _ in range(n)] for _ in range(m)]
        
        for k in range(3):
            dp[m-1][n-1][k] = 0 if coins[m-1][n-1] < 0 and k else coins[m-1][n-1]
        
        for i in range(m-1, -1, -1):
            for j in range(n-1, -1, -1):
                for k in range(3):
                    if i == m-1 and j == n-1: continue
                    
                    best = -10**15
                    if i+1 < m: best = max(best, dp[i+1][j][k])
                    if j+1 < n: best = max(best, dp[i][j+1][k])
                    
                    take = coins[i][j] + best
                    
                    skip = -10**15
                    if coins[i][j] < 0 and k:
                        if i+1 < m: skip = max(skip, dp[i+1][j][k-1])
                        if j+1 < n: skip = max(skip, dp[i][j+1][k-1])
                    
                    dp[i][j][k] = max(take, skip)
        
        return dp[0][0][2]
