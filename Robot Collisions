from typing import List

class Solution:
    def survivedRobotsHealths(self, pos: List[int], health: List[int], dir: str) -> List[int]:
        robots = sorted(range(len(pos)), key=lambda i: pos[i])
        stack = []
        
        for i in robots:
            if dir[i] == 'R':
                stack.append(i)
            else:
                while stack and health[i] > 0:
                    j = stack[-1]
                    if health[j] < health[i]:
                        stack.pop()
                        health[i] -= 1
                        health[j] = 0
                    elif health[j] > health[i]:
                        health[j] -= 1
                        health[i] = 0
                    else:
                        stack.pop()
                        health[i] = health[j] = 0
        
        return [h for h in health if h > 0]
